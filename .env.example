QUEST_CODER_RUNNER_URL=http://127.0.0.1:8787
QUEST_CODER_RUNNER_TOKEN=replace-with-a-long-random-value
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ALLOW_INDEXING=false
# Number of proxies you run in front of the app (1 for a single load balancer or platform edge).
