QUEST_CODER_RUNNER_URL=http://127.0.0.1:8787
QUEST_CODER_RUNNER_TOKEN=replace-with-a-long-random-value
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ALLOW_INDEXING=false
# Production account/progress mode. Leave all three unset for credential-free
# local SQLite + display-name sessions. Never expose the service-role key.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Number of proxies you run in front of the app (1 for a single load balancer or platform edge).
# Enables per-address sign-up limits; leave at 0 when the app is reached directly.
QUEST_CODER_TRUSTED_PROXY_HOPS=0
