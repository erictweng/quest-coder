      "starterCode": "def first_step(head: Optional[ListNode]) -> List[int]:\n    pass\n",
      "hints": [
        {
          "id": "h1",
          "text": "Which pointer changes first?",
          "cost": "free"
        },
        {
          "id": "h2",
          "text": "What should be saved before rewiring next?",
          "cost": "reduces_reward"
        }
      ],
      "solution": {
        "code": "def first_step(head: Optional[ListNode]) -> List[int]:\n    slow = head.next\n    fast = head.next.next\n    return [slow.val, fast.val]\n",
        "explanation": "Walk the portal chain while keeping pointer state explicit.",
        "complexity": {
          "time": "O(n)",
          "space": "O(1)"
        }
      },
