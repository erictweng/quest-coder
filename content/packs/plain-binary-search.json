  "quests": [
    {
      "id": "binary-window",
      "order": 1,
      "title": "Quest 1: Hold the window",
      "brief": "Search a calm sorted hallway before harder timequakes.",
      "learningGoal": "Practice binary search boundaries.",
      "signature": "class Solution:\n    def search(self, nums: List[int], target: int) -> int:",
      "entrypoint": "Solution().search",
      "starterCode": "class Solution:\n    def search(self, nums: List[int], target: int) -> int:\n        pass\n",
      "hints": [
        {
          "id": "h1",
          "text": "Where should l and r start?",
          "cost": "free"
        }
      ],
      "solution": {
        "code": "class Solution:\n    def search(self, nums: List[int], target: int) -> int:\n        l = 0\n        r = len(nums) - 1\n        while l <= r:\n            mid = (l + r) // 2\n            if nums[mid] == target:\n                return mid\n            if nums[mid] < target:\n                l = mid + 1\n            else:\n                r = mid - 1\n        return -1\n",
        "explanation": "Cut the sorted hallway in half until target is found or absent.",
        "complexity": {
          "time": "O(log n)",
          "space": "O(1)"
        }
      },
      "tests": {
