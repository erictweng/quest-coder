      "title": "Quest 2: Rewire one portal",
      "brief": "Reverse a two-node chain.",
      "learningGoal": "Practice linked-list pointer movement.",
      "signature": "def reverse_two(head: Optional[ListNode]) -> Optional[ListNode]:",
      "entrypoint": "reverse_two",
      "starterCode": "def reverse_two(head: Optional[ListNode]) -> Optional[ListNode]:\n    pass\n",
      "hints": [
        {
          "id": "h1",
          "text": "Which pointer changes first?",
          "cost": "free"
        },
        {
          "id": "h2",
          "text": "What should be saved before rewiring next?",
          "cost": "reduces_reward"
        }
      ],
      "solution": {
        "code": "def reverse_two(head: Optional[ListNode]) -> Optional[ListNode]:\n    second = head.next\n    second.next = head\n    head.next = None\n    return second\n",
        "explanation": "Walk the portal chain while keeping pointer state explicit.",
        "complexity": {
          "time": "O(n)",
          "space": "O(1)"
        }
      },
