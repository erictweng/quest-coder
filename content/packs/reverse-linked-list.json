  "boss": {
    "id": "boss-reverse-linked-list",
    "order": 1,
    "title": "Boss: Reverse the Portal Chain",
    "brief": "Reverse every portal so the chain points backward.",
    "learningGoal": "Practice linked-list pointer movement.",
    "signature": "class Solution:\n    def reverseList(self, head: Optional[ListNode]) -> Optional[ListNode]:",
    "entrypoint": "Solution().reverseList",
    "starterCode": "class Solution:\n    def reverseList(self, head: Optional[ListNode]) -> Optional[ListNode]:\n        pass\n",
    "hints": [
      {
        "id": "h1",
        "text": "Which pointer changes first?",
        "cost": "free"
      },
      {
        "id": "h2",
        "text": "What should be saved before rewiring next?",
        "cost": "reduces_reward"
      }
    ],
    "solution": {
      "code": "class Solution:\n    def reverseList(self, head: Optional[ListNode]) -> Optional[ListNode]:\n        prev = None\n        curr = head\n        while curr:\n            next = curr.next\n            curr.next = prev\n            prev = curr\n            curr = next\n        return prev\n",
      "explanation": "Walk the portal chain while keeping pointer state explicit.",
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      }
    },
