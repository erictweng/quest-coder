  "quests": [
    {
      "id": "save-next",
      "order": 1,
      "title": "Quest 1: Save the next portal",
      "brief": "Return the values seen while walking the chain.",
      "learningGoal": "Practice linked-list pointer movement.",
      "signature": "def walk_values(head: Optional[ListNode]) -> List[int]:",
      "entrypoint": "walk_values",
      "starterCode": "def walk_values(head: Optional[ListNode]) -> List[int]:\n    pass\n",
      "hints": [
        {
          "id": "h1",
          "text": "Which pointer changes first?",
          "cost": "free"
        },
        {
          "id": "h2",
          "text": "What should be saved before rewiring next?",
          "cost": "reduces_reward"
        }
      ],
      "solution": {
        "code": "def walk_values(head: Optional[ListNode]) -> List[int]:\n    values = []\n    curr = head\n    while curr:\n        values.append(curr.val)\n        curr = curr.next\n    return values\n",
        "explanation": "Walk the portal chain while keeping pointer state explicit.",
        "complexity": {
          "time": "O(n)",
          "space": "O(1)"
        }
      },
      "tests": {
        "fixed": [
