{
  "name": "quest-coder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": { "node": ">=24 <27" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "typecheck": "tsc --noEmit",
    "build:packs": "python3 scripts/build_pack_projections.py",
    "test:packs": "python3 scripts/build_pack_projections.py --check",
    "test:privacy": "python3 scripts/privacy_check.py",
    "private-pack:generate": "python3 scripts/private_pack.py generate",
    "private-pack:validate": "python3 scripts/private_pack.py validate",
    "test:unit": "node --test 'tests/unit/*.test.ts'",
    "test:runner": "python3 -m unittest discover -s runner/tests -p 'test_*.py' -v",
    "runner:service": "python3 runner/service/app.py",
    "test:e2e": "playwright test --project=chromium-full",
    "test:e2e:smoke": "QUEST_CODER_E2E_DEV_SERVER=1 playwright test --project=chromium-smoke --project=firefox-smoke --project=webkit-smoke --project=mobile-chromium-smoke",
    "test:e2e:accessibility": "playwright test --project=chromium-accessibility",
    "smoke:deployment": "node scripts/deployment_smoke.mjs",
    "test:provenance": "node scripts/test_provenance.mjs",
    "test:trusted-slice": "npm run lint && npm run test:packs && npm run test:unit && npm run test:runner && npm run build && npm run test:privacy && npm run test:e2e && npm run test:e2e:smoke && npm run test:e2e:accessibility"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tailwindcss/postcss": "4.3.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
