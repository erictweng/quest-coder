{
  "name": "quest-coder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": { "node": ">=24 <27" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:runner": "python3 -m unittest discover -s runner/tests -p 'test_*.py' -v",
    "smoke:sprint2": "node scripts/sprint2-smoke.mjs",
    "smoke:sprint3": "node scripts/sprint3-smoke.mjs",
    "smoke:sprint4": "node scripts/sprint4-smoke.mjs",
    "smoke:sprint5": "node scripts/sprint5-smoke.mjs",
    "smoke:sprint6": "node scripts/sprint6-smoke.mjs",
    "smoke:sprint7": "node scripts/sprint7-smoke.mjs",
    "smoke:sprint8": "node scripts/sprint8-smoke.mjs",
    "smoke:sprint9": "node scripts/sprint9-smoke.mjs",
    "smoke:sprint10": "node scripts/sprint10-smoke.mjs",
    "smoke:sprint11": "node scripts/sprint11-smoke.mjs",
    "smoke:sprint12": "node scripts/sprint12-smoke.mjs",
    "smoke:sprint13": "node scripts/sprint13-smoke.mjs",
    "smoke:sprint14": "node scripts/sprint14-smoke.mjs",
    "smoke:sprint15": "node scripts/sprint15-smoke.mjs",
    "smoke:cyberpunk-token": "node scripts/cyberpunk-token-smoke.mjs",
    "smoke:cyberpunk-hub": "node scripts/cyberpunk-hub-smoke.mjs",
    "smoke:cyberpunk-campaign": "node scripts/cyberpunk-campaign-smoke.mjs",
    "smoke:cyberpunk-solve": "node scripts/cyberpunk-solve-smoke.mjs",
    "smoke:cyberpunk-assets": "node scripts/cyberpunk-assets-smoke.mjs",
    "smoke:cyberpunk-bit": "node scripts/cyberpunk-bit-smoke.mjs",
    "smoke:ui-redesign": "node scripts/ui-redesign-smoke.mjs",
    "smoke:climbing-stairs": "node scripts/climbing-stairs-smoke.mjs",
    "smoke:one-question-workspace": "node scripts/one-question-workspace-smoke.mjs",
    "smoke:bugfix-regressions": "node scripts/bugfix-regressions-smoke.mjs",
    "runner:service": "python3 runner/service/app.py",
    "test:e2e": "playwright test",
    "test:smoke": "npm run smoke:bugfix-regressions && npm run smoke:climbing-stairs && npm run smoke:one-question-workspace && npm run smoke:ui-redesign && npm run smoke:cyberpunk-bit",
    "test:trusted-slice": "npm run typecheck && npm run test:runner && npm run test:smoke && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
