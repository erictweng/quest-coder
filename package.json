{
  "name": "quest-coder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": { "node": ">=24 <27" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "typecheck": "tsc --noEmit",
    "build:packs": "python3 scripts/build_pack_projections.py",
    "test:packs": "python3 scripts/build_pack_projections.py --check",
    "test:unit": "node --test 'tests/unit/*.test.ts'",
    "test:runner": "python3 -m unittest discover -s runner/tests -p 'test_*.py' -v",
    "runner:service": "python3 runner/service/app.py",
    "test:e2e": "next build && playwright test",
    "test:trusted-slice": "npm run lint && npm run test:packs && npm run test:unit && npm run test:runner && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tailwindcss/postcss": "4.3.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
